1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="330" width="200" height="60" as="geometry"/></mxCell><mxCell id="c23" value="ASG asg-web · mín 2 / máx 4 · health check HTTP /health" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_auto_scaling_group;strokeColor=#ED7100;fillColor=none;fontColor=#ED7100;dashed=1;" vertex="1" parent="1"><mxGeometry x="255" y="440" width="980" height="135" as="geometry"/></mxCell><mxCell id="c24" value="ASG asg-api · mín 2 / máx 4 · health check HTTP /actuator/health" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_auto_scaling_group;strokeColor=#ED7100;fillColor=none;fontColor=#ED7100;dashed=1;" vertex="1" parent="1"><mxGeometry x="255" y="610" width="980" height="150" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Backup&lt;/b&gt;&lt;br&gt;• RDS: backup automático de 7 dias (PITR)&lt;br&gt;• semanal e mensal: export para o S3 (GFS)&lt;br&gt;• HA não substitui backup: a réplica apaga junto" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="830" width="240" height="150" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Legenda:&lt;/b&gt; &lt;font color=&quot;#007FFF&quot;&gt;&lt;b&gt;1&lt;/b&gt; usuário → ALB → web/api → RDS&lt;/font&gt; · &lt;font color=&quot;#2D7600&quot;&gt;&lt;b&gt;2&lt;/b&gt; administrador → bastion → instâncias (ssh -J)&lt;/font&gt; · &lt;font color=&quot;#B36B00&quot;&gt;&lt;b&gt;3&lt;/b&gt; instâncias privadas → NAT da própria zona → internet&lt;/font&gt;. Web e API ficam em sub-redes privadas; só o ALB, o bastion e os NAT têm IP público. Sessão do usuário: HTTP Basic, sem estado no servidor (qualquer instância atende qualquer requisição). A aplicação não recebe arquivos." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="1050" width="1420" height="60" as="geometry"/></mxCell><mxCell id="c34" value="DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#007FFF;fontColor=#007FFF;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="68"/></Array></mxGeometry></mxCell><mxCell id="c35" value="1 HTTPS :443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#007FFF;fontColor=#007FFF;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="280"/><mxPoint x="170" y="138"/></Array></mxGeometry></mxCell><mxCell id="c36" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#007FFF;fontColor=#007FFF;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="